	<sys:String x:Key="MenuAbout_Version">Version: 1.0.0</sys:String>
	<sys:String x:Key="MenuAbout_Description">A professional tool for comparing differences between two Excel files.</sys:String>
	<sys:String x:Key="MenuAbout_InstructionsTitle">Instructions:</sys:String>
