<Window x:Class="ExcelMerger.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutTitle}" 
        Width="380" 
        SizeToContent="Height" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False">

    <!-- 使用平滑的背景色和内边距 -->
    <Grid Margin="20">
        <StackPanel>
            <!-- 提示信息：确保 TextWrapping 为 Wrap 以防文件名超长 -->
            <TextBlock x:Name="LblMessage" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,12" 
                       FontSize="13"
                       LineHeight="20"/>

            <!-- 密码输入框 -->
            <PasswordBox x:Name="TxtPassword" 
                         PasswordChar="*" 
                         Height="28"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,20"/>

            <!-- 按钮区域 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource BtnOk}" 
                        Click="Ok_Click" 
                        IsDefault="True" 
                        Width="85" 
                        Height="28" 
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource BtnCancel}" 
                        IsCancel="True" 
                        Width="85" 
                        Height="28"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>