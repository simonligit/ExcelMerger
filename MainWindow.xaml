<Window x:Class="ExcelMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelMerger"
        xmlns:conv="clr-namespace:ExcelMerger.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" AllowDrop="True" 
        Drop="Window_Drop" DragOver="Window_DragOver"
        Height="600" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenSelectFilesCommand}"/>
    </Window.InputBindings>
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuNew}" InputGestureText="Ctrl+N" Command="{Binding OpenSelectFilesCommand}"/>
                <Separator />
                <MenuItem Header="{DynamicResource MenuExit}" Click="MenuItem_Exit_Click"/>
            </MenuItem>

            <MenuItem Header="{DynamicResource MenuLanguage}">
                <MenuItem Header="English" Click="SwitchToEnglish_Click">
                    <MenuItem.Icon>
                        <Image Source="Resources/en_flag.png" Width="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="中文 (简体)" Click="SwitchToChinese_Click"/>
            </MenuItem>

            <MenuItem Header="{DynamicResource MenuHelp}">
                <MenuItem Header="{DynamicResource MenuAbout}" Click="MenuItem_About_Click"/>
            </MenuItem>
            
        </Menu>

        <ProgressBar DockPanel.Dock="Top" Height="10" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- show full file paths above the main content (same top-level placement as ProgressBar) -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" Padding="6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Label_LeftFile}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LeftFilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftFilePath}" Width="420"/>
                <TextBlock Text=" | " Width="8"/>
                <TextBlock Text="{DynamicResource Label_RightFile}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RightFilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RightFilePath}" Width="420"/>
            </StackPanel>
        </Border>

        <!-- compare mode switch: Row mode (side-by-side) / Column mode (stacked + horizontal minimap) -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" Padding="6,2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource CompareModeLabel}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <RadioButton GroupName="CompareMode" Content="{DynamicResource RowModeLabel}" Margin="0,0,12,0" VerticalAlignment="Center"
                             IsChecked="{Binding IsColumnMode, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}"/>
                <RadioButton GroupName="CompareMode" Content="{DynamicResource ColumnModeLabel}" VerticalAlignment="Center"
                             IsChecked="{Binding IsColumnMode, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{DynamicResource StatusReady}"/>
        </StatusBar>

        <Grid x:Name="MainContentArea">
            <!-- Move property elements (ColumnDefinitions) before content to satisfy XAML rules -->
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource HintStart}"
               Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="5"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="16" Foreground="Gray">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 垂直 Minimap（行模式）：按行状态着色 -->
            <Grid Grid.Row="1" Grid.Column="0" Background="#F0F0F0" Margin="2,0" PreviewMouseDown="Minimap_PreviewMouseDown"
                  Visibility="{Binding IsColumnMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <!-- Define row structure before child content -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl ItemsSource="{Binding SelectedItem.LeftRows, ElementName=MainTabControl}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle x:Name="Marker" Height="2" Fill="Transparent" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Added">
                                    <Setter TargetName="Marker" Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                    <Setter TargetName="Marker" Property="Fill" Value="#DC3545"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Modified">
                                    <Setter TargetName="Marker" Property="Fill" Value="#FFC107"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Empty">
                                    <Setter TargetName="Marker" Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas x:Name="MinimapCanvas" Background="Transparent" IsHitTestVisible="False">
                    <Rectangle x:Name="ViewportIndicator"
                   Width="25"
                   Fill="#40AAAAAA"
                   Stroke="#808080"
                   StrokeThickness="1"
                   MinHeight="5"/>
                </Canvas>
            </Grid>

            <!-- 水平 Minimap（列模式）：按对齐列的状态着色，点击可水平定位到对应列 -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#F0F0F0" Margin="0,2" PreviewMouseDown="MinimapHorizontal_PreviewMouseDown"
                  Visibility="{Binding IsColumnMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding SelectedItem.ColumnStatuses, ElementName=MainTabControl}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle x:Name="Marker" Width="2" Fill="Transparent" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Added">
                                    <Setter TargetName="Marker" Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                    <Setter TargetName="Marker" Property="Fill" Value="#DC3545"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Modified">
                                    <Setter TargetName="Marker" Property="Fill" Value="#FFC107"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Empty">
                                    <Setter TargetName="Marker" Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas x:Name="MinimapCanvasH" Background="Transparent" IsHitTestVisible="False">
                    <Rectangle x:Name="ViewportIndicatorH"
                   Height="16"
                   Fill="#40AAAAAA"
                   Stroke="#808080"
                   StrokeThickness="1"
                   MinWidth="5"/>
                </Canvas>
            </Grid>

            <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.Column="1"
                        Background="Transparent" BorderThickness="0"
                        ItemsSource="{Binding Sheets}" SelectedIndex="{Binding SelectedSheetIndex, Mode=TwoWay}" 
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SheetName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" Background="#F3F3F3">
                                <!-- 标签随模式切换：行模式=关键字列，列模式=关键行 -->
                                <TextBlock VerticalAlignment="Center" Margin="5,0,10,0" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource KeyColumnsLabel}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsColumnMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource KeyRowsLabel}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 关键字（列/行）选择区：数量可能很多，包一层可横向滚动的区域 -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              MaxWidth="620" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding ColumnHeaderList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding HeaderName}" IsChecked="{Binding IsKeyColumn}" Margin="5,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Content="{DynamicResource BtnReCompare}" Margin="20,0,5,0" Padding="10,2"
                                        Command="{Binding DataContext.ReCompareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                            <!-- 行模式：左右并排显示两个文件 -->
                            <Grid Grid.Row="1"
                                  Visibility="{Binding DataContext.IsColumnMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="RowHighlightStyle" TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Modified">
                                                <Setter Property="Background" Value="Moccasin"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Added">
                                                <Setter Property="Background" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                                <Setter Property="Background" Value="LightPink"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Empty">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style TargetType="DataGridRowHeader">
                                        <Setter Property="Width" Value="40"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                    </Style>
                                </Grid.Resources>

                                <DataGrid x:Name="LeftDataGrid" Grid.Column="0"
                                          ItemsSource="{Binding LeftRows}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          RowStyle="{StaticResource RowHighlightStyle}"
                                          ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                                          HeadersVisibility="All"
                                          LoadingRow="DataGrid_LoadingRow"/>
                                <DataGrid Grid.Column="1" x:Name="RightDataGrid"
                                          ItemsSource="{Binding RightRows}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          RowStyle="{StaticResource RowHighlightStyle}"
                                          ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                                          HeadersVisibility="All"
                                          LoadingRow="DataGrid_LoadingRow"/>
                            </Grid>

                            <!-- 列模式：上下堆叠显示两个文件，高亮按整列进行（见 ColumnCellConverter） -->
                            <Grid Grid.Row="1"
                                  Visibility="{Binding DataContext.IsColumnMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="DataGridRowHeader">
                                        <Setter Property="Width" Value="40"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                    </Style>
                                </Grid.Resources>

                                <DataGrid x:Name="TopDataGrid" Grid.Row="0"
                                          ItemsSource="{Binding LeftRows}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                                          HeadersVisibility="All"
                                          LoadingRow="DataGrid_LoadingRow"/>
                                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              Background="#DDDDDD" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" ShowsPreview="False"/>
                                <DataGrid x:Name="BottomDataGrid" Grid.Row="2"
                                          ItemsSource="{Binding RightRows}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                                          ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                                          HeadersVisibility="All"
                                          LoadingRow="DataGrid_LoadingRow"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>