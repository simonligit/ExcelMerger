<Window x:Class="ExcelMerger.SelectFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelMerger"
        mc:Ignorable="d"
        Title="{DynamicResource SelectFilesDialog_Title}" Height="300" Width="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource SelectFilesDialog_Label1}"/>
        <DockPanel Margin="0,5,0,10">
            <Button Content="{DynamicResource BtnBrowse}" Click="BrowseFile1_Click" DockPanel.Dock="Right" Width="75"/>
            <!-- made editable and allow dropping/pasting; tooltip hints user can paste -->
            <TextBox x:Name="TxtFile1" IsReadOnly="False" AllowDrop="True" Margin="0,0,5,0"
                     ToolTip="{DynamicResource Hint_PasteOrBrowse_FilePath}"/>
        </DockPanel>

        <Button Content="{DynamicResource BtnSwap}" 
                HorizontalAlignment="Right" 
                Margin="0,0,80,5" 
                Padding="10,2"
                FontSize="11"
                Click="SwapFiles_Click" 
                Background="#F0F0F0"/>

        <TextBlock Text="{DynamicResource SelectFilesDialog_Label2}"/>
        <DockPanel Margin="0,5,0,10">
            <Button Content="{DynamicResource BtnBrowse}" Click="BrowseFile2_Click" DockPanel.Dock="Right" Width="75"/>
            <TextBox x:Name="TxtFile2" IsReadOnly="False" AllowDrop="True" Margin="0,0,5,0"
                     ToolTip="{DynamicResource Hint_PasteOrBrowse_FilePath}"/>
        </DockPanel>

        <UniformGrid Columns="2" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnOk}" Click="Ok_Click" Margin="5"/>
            <Button Content="{DynamicResource BtnCancel}" IsCancel="True" Margin="5"/>
        </UniformGrid>
    </StackPanel>
</Window>
