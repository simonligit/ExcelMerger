<Window x:Class="ExcelMerger.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MenuAbout_AboutTitle}" 
        Height="348" Width="472" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="120"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" VerticalAlignment="Top">
			<Image Source="Resources/app_icon.ico" Width="80" Height="80" Margin="0,10,0,10"/>
			<TextBlock Text="{DynamicResource MenuAbout_Version}" HorizontalAlignment="Center" Foreground="Gray"/>
		</StackPanel>

		<StackPanel Grid.Column="1" Margin="15,0,0,0">
			<TextBlock Text="Excel Professional Comparator" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
			<TextBlock Text="{DynamicResource MenuAbout_Description}" TextWrapping="Wrap" Margin="0,0,0,15"/>

			<Separator Margin="0,0,0,15"/>

			<TextBlock Text="{DynamicResource MenuAbout_InstructionsTitle}" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBlock Text="{DynamicResource MenuAbout_Instruction1}" TextWrapping="Wrap" FontSize="12" Margin="5,0,0,2"/>
			<TextBlock Text="{DynamicResource MenuAbout_Instruction2}" TextWrapping="Wrap" FontSize="12" Margin="5,0,0,2"/>
			<TextBlock Text="{DynamicResource MenuAbout_Instruction3}" TextWrapping="Wrap" FontSize="12" Margin="5,0,0,2"/>

			<TextBlock Text="{DynamicResource MenuAbout_Copyright}" Margin="0,30,0,0" FontSize="10" VerticalAlignment="Bottom"/>

			<Button Content="{DynamicResource BtnOk}" Width="80" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" Click="Close_Click"/>
		</StackPanel>
	</Grid>
</Window>